# ==============================================================
# Xray Config Manager 环境变量示例配置 (.env.example)
# 使用方法：复制本文件为 .env 并按需修改：
#   cp .env.example .env
# ==============================================================

# 服务监听端口 (默认: 8080)
PORT=8080

# 服务监听地址 (默认: 0.0.0.0)
HOST=0.0.0.0

# Web 应用固定登录认证账号 (默认: admin)
APP_USERNAME=admin

# Web 应用固定登录认证密码 (默认: admin123456)
APP_PASSWORD=admin123456

# JWT 鉴权密钥 (用于签名登录 Token，生产环境建议修改为高强度随机字符串)
JWT_SECRET=xray-cfg-secret-jwt-key-2026-secure

# 本地维护的目标 Xray 配置文件路径 (相对项目根目录或绝对路径，默认: config.json)
CONFIG_FILE_PATH=config.json

# SQLite 数据库文件存储路径 (默认: xray_cfg.db)
DB_PATH=xray_cfg.db
